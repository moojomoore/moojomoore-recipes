<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Description</key>
  <string>Downloads the latest version of Sparrow and creates a package. Set ARCH to "aarch64" (default) for Apple Silicon or "x86_64" for Intel.</string>
  <key>Identifier</key>
  <string>com.github.moojomoore.pkg.Sparrow</string>
  <key>Input</key>
  <dict>
    <key>APP_NAME</key>
    <string>Sparrow</string>
    <key>BUNDLE_ID</key>
    <string>com.sparrowwallet.sparrow</string>
    <key>NAME</key>
    <string>Sparrow</string>
  </dict>
  <key>MinimumVersion</key>
  <string>2.0</string>
  <key>ParentRecipe</key>
  <string>com.github.moojomoore.download.Sparrow</string>
  <key>Process</key>
  <array>
    <dict>
      <key>Processor</key>
      <string>PkgRootCreator</string>
      <key>Arguments</key>
      <dict>
        <key>pkgdirs</key>
        <dict>
          <key>Applications</key>
          <string>0775</string>
        </dict>
        <key>pkgroot</key>
        <string>%RECIPE_CACHE_DIR%/pkgroot</string>
      </dict>
    </dict>
    <dict>
      <key>Processor</key>
      <string>Copier</string>
      <key>Arguments</key>
      <dict>
        <key>source_path</key>
        <string>%pathname%/%APP_NAME%.app</string>
        <key>destination_path</key>
        <string>%pkgroot%/Applications/%APP_NAME%.app</string>
      </dict>
    </dict>
    <dict>
      <key>Processor</key>
      <string>PkgCreator</string>
      <key>Arguments</key>
      <dict>
        <key>pkg_request</key>
        <dict>
          <key>chown</key>
          <array>
            <dict>
              <key>path</key>
              <string>Applications</string>
              <key>user</key>
              <string>root</string>
              <key>group</key>
              <string>admin</string>
            </dict>
          </array>
          <key>id</key>
          <string>%BUNDLE_ID%</string>
          <key>pkgname</key>
          <string>%NAME%-%version%-%ARCH%</string>
          <key>pkgroot</key>
          <string>%pkgroot%</string>
          <key>version</key>
          <string>%version%</string>
        </dict>
      </dict>
    </dict>
  </array>
</dict>
</plist>
