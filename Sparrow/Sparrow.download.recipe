<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Description</key>
  <string>Downloads the latest version of Sparrow for macOS. Set ARCH to "aarch64" (default) for Apple Silicon or "x86_64" for Intel.</string>
  <key>Identifier</key>
  <string>com.github.moojomoore.download.Sparrow</string>
  <key>Input</key>
  <dict>
    <key>ARCH</key>
    <string>aarch64</string>
    <key>NAME</key>
    <string>Sparrow</string>
  </dict>
  <key>MinimumVersion</key>
  <string>2.0</string>
  <key>Process</key>
  <array>
    <dict>
      <key>Processor</key>
      <string>GitHubReleasesInfoProvider</string>
      <key>Arguments</key>
      <dict>
        <key>github_repo</key>
        <string>sparrowwallet/sparrow</string>
        <key>asset_regex</key>
        <string>Sparrow-[0-9.]+-%ARCH%\.dmg</string>
      </dict>
    </dict>
    <dict>
      <key>Processor</key>
      <string>URLDownloader</string>
      <key>Arguments</key>
      <dict>
        <key>filename</key>
        <string>%NAME%-%version%-%ARCH%.dmg</string>
      </dict>
    </dict>
    <dict>
      <key>Processor</key>
      <string>EndOfCheckPhase</string>
    </dict>
    <dict>
      <key>Processor</key>
      <string>CodeSignatureVerifier</string>
      <key>Arguments</key>
      <dict>
        <key>input_path</key>
        <string>%pathname%/Sparrow.app</string>
        <key>requirement</key>
        <string>identifier "com.sparrowwallet.sparrow" and anchor apple generic and certificate 1[field.1.2.840.113635.100.6.2.6] /* exists */ and certificate leaf[field.1.2.840.113635.100.6.1.13] /* exists */ and certificate leaf[subject.OU] = UPLVMSK9D7</string>
      </dict>
    </dict>
    <dict>
      <key>Processor</key>
      <string>Versioner</string>
      <key>Arguments</key>
      <dict>
        <key>input_plist_path</key>
        <string>%pathname%/Sparrow.app/Contents/Info.plist</string>
        <key>plist_version_key</key>
        <string>CFBundleShortVersionString</string>
      </dict>
    </dict>
  </array>
</dict>
</plist>
